<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/challenge_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="start"
            android:layout_marginBottom="20dp" />

        <!-- Badge Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="28dp">

            <!-- Badge Icon -->
            <ImageView
                android:id="@+id/badgeIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_badge_bronze"
                android:layout_marginBottom="12dp" />

            <!-- Badge Title -->
            <TextView
                android:id="@+id/badgeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="青铜 1星"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <!-- Badge Subtitle -->
            <TextView
                android:id="@+id/badgeSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_sub"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Rank Progress -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <!-- Progress Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/intensity_8">
                <View
                    android:id="@+id/rankFill"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rank_fill" />
            </FrameLayout>
            <!-- Label Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="青铜"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.7" />
                <TextView
                    android:id="@+id/rankInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20/100"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="白银"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.7"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Challenge Stats -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Total Games -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/csGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_games"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Best Speed -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/csBestSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_best_speed"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Best Accuracy -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/csBestAcc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_best_acc"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start Button -->
        <Button
            android:id="@+id/btnStartChallenge"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_challenge"
            android:textSize="15sp"
            android:textColor="@color/destructive"
            android:background="@drawable/bg_btn_red_outline"
            android:padding="14dp" />

    </LinearLayout>

</ScrollView>
