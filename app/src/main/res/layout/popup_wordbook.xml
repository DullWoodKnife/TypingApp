<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_box"
    android:padding="6dp"
    android:elevation="8dp">

    <!-- 按钮同行，可横向滑动，避免按钮过多时溢出屏幕 -->
    <HorizontalScrollView
        android:id="@+id/popup_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/popup_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/popup_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:padding="8dp"
                android:background="@drawable/bg_popup_add" />

            <TextView
                android:id="@+id/popup_highlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#9A6A00"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_popup_add" />

            <TextView
                android:id="@+id/popup_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_popup_add" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
